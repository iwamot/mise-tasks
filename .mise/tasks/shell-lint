#!/usr/bin/env bash
#MISE description="Lint shell scripts with shfmt and shellcheck"
#MISE tools={"aqua:koalaman/shellcheck"="0.11.0","aqua:mvdan/sh"="3.14.1"}
set -e

cd "$MISE_PROJECT_ROOT"

# shfmt -f detects shell files (extension or shebang) while walking the tree;
# intersect with git ls-files so vendored scripts (.venv, node_modules, ...)
# are skipped without per-repo ignore lists.
# Both lists are NUL-separated because git quotes non-ASCII and other unusual
# paths in its default output, which would never match shfmt's raw paths.
# Discover both lists in the foreground, into files, so either command's
# failure stops the task rather than looking like an empty set of shell files.
lists=$(mktemp -d)
trap 'rm -rf "$lists"' EXIT
git ls-files -z >"$lists/tracked"
shfmt -f=0 . >"$lists/detected"

declare -A tracked=()
while IFS= read -r -d '' file; do
  tracked["$file"]=1
done <"$lists/tracked"
shell_files=()
while IFS= read -r -d '' file; do
  if [[ -n "${tracked["$file"]:-}" ]]; then
    shell_files+=("$file")
  fi
done <"$lists/detected"
[[ ${#shell_files[@]} -eq 0 ]] && exit 0

shfmt -w -i 2 "${shell_files[@]}"
shellcheck "${shell_files[@]}"
