#!/usr/bin/env bash
#MISE description="Lint shell scripts with shfmt and shellcheck"
#MISE tools={"aqua:koalaman/shellcheck"="0.11.0","aqua:mvdan/sh"="3.14.1"}
set -e

cd "$MISE_PROJECT_ROOT"

# shfmt -f detects shell files (extension or shebang) while walking the tree;
# intersect with git ls-files so vendored scripts (.venv, node_modules, ...)
# are skipped without per-repo ignore lists.
# Discover both lists in the foreground so either command's failure stops the
# task rather than looking like an empty set of shell files.
tracked_files=$(git ls-files)
detected_files=$(shfmt -f .)
[[ -z "$tracked_files" || -z "$detected_files" ]] && exit 0
mapfile -t shell_files < <(printf '%s\n' "$detected_files" | grep -Fx -f <(printf '%s\n' "$tracked_files") || true)
[[ ${#shell_files[@]} -eq 0 ]] && exit 0

shfmt -w -i 2 "${shell_files[@]}"
shellcheck "${shell_files[@]}"
