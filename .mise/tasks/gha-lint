#!/usr/bin/env bash
#MISE description="Run GitHub Actions lint suite"
#MISE tools={"aqua:koalaman/shellcheck"="0.11.0","github:jdx/jactionlint"="v2.5.0","aqua:suzuki-shunsuke/ghalint"="1.6.0","aqua:suzuki-shunsuke/pinact"="5.0.2","aqua:zizmorcore/zizmor"="1.32.0","github:github/gh-actions-lock"={version="v0.4.1",bin="gh-actions-lock"}}
set -e

cd "$MISE_PROJECT_ROOT"

# pinact and jactionlint's online checks query the GitHub API, which rate-limits
# unauthenticated requests. CI already provides GITHUB_TOKEN, so this only fills
# it in for local runs, falling back to the gh CLI's token when available.
: "${GITHUB_TOKEN:=$(gh auth token 2>/dev/null || true)}"
export GITHUB_TOKEN

pinact run --verify
# "." so composite actions (<name>/action.yml) are audited alongside workflows.
zizmor --fix --pedantic .
# --online checks calls to remote actions and reusable workflows against what
# they declare at the pinned ref, so a bump that changes those is caught here.
jactionlint --fix --online
ghalint run
ghalint run-action

if [ -f .github/workflows/actions.lock ]; then
  gh-actions-lock --verify
fi
