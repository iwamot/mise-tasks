#!/usr/bin/env bash
#MISE description="Run GitHub Actions lint suite"
#MISE tools={"aqua:koalaman/shellcheck"="0.11.0","github:kjanat/actionlint"="1.13.0","aqua:suzuki-shunsuke/ghalint"="1.5.6","aqua:suzuki-shunsuke/pinact"="4.1.1","aqua:zizmorcore/zizmor"="1.30.0"}
set -e

cd "$MISE_PROJECT_ROOT"

# pinact verifies SHA pins against the GitHub API, which rate-limits
# unauthenticated requests. CI already provides GITHUB_TOKEN, so this only fills
# it in for local runs, falling back to the gh CLI's token when available.
: "${GITHUB_TOKEN:=$(gh auth token 2>/dev/null || true)}"
export GITHUB_TOKEN

pinact run --verify
# "." so composite actions (<name>/action.yml) are audited alongside workflows.
zizmor --fix --pedantic .
# actionlint comes from the kjanat/actionlint fork: upstream rhysd/actionlint has
# had no release since 1.7.12 (2026-03) and rejects the "$/" self-repository
# syntax that zizmor's self-repository audit rewrites "./" references into
# (rhysd/actionlint#711). Switch back once an upstream release accepts "$/".
actionlint
ghalint run
ghalint run-action
