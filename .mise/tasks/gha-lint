#!/usr/bin/env bash
#MISE description="Run GitHub Actions lint suite"
#MISE tools={"aqua:koalaman/shellcheck"="0.11.0","github:jdx/jactionlint"="2.4.0","aqua:suzuki-shunsuke/ghalint"="1.5.7","aqua:suzuki-shunsuke/pinact"="5.0.2","aqua:zizmorcore/zizmor"="1.31.1","github:github/gh-actions-lock"={version="0.4.0",bin="gh-actions-lock"}}
set -e

cd "$MISE_PROJECT_ROOT"

# pinact verifies SHA pins against the GitHub API, which rate-limits
# unauthenticated requests. CI already provides GITHUB_TOKEN, so this only fills
# it in for local runs, falling back to the gh CLI's token when available.
: "${GITHUB_TOKEN:=$(gh auth token 2>/dev/null || true)}"
export GITHUB_TOKEN

pinact run --verify
# "." so composite actions (<name>/action.yml) are audited alongside workflows.
zizmor --fix --pedantic .
jactionlint --fix
ghalint run
ghalint run-action

if [ -f .github/workflows/actions.lock ]; then
  gh-actions-lock --verify
fi
