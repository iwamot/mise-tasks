#!/usr/bin/env bash
#MISE description="Enable pre-commit (./validate.sh) and commit-msg (DCO + Conventional Commits) hooks (requires Git 2.54+)"
set -e

git config hook.validate.event pre-commit
git config hook.validate.command ./validate.sh

git config hook.dco.event commit-msg
DCO_HOOK_CMD=$(
  cat <<'EOF'
f() { grep -q "^Signed-off-by: " "$1" || { echo "Missing Signed-off-by trailer" >&2; exit 1; }; }; f
EOF
)
git config hook.dco.command "$DCO_HOOK_CMD"

git config hook.conventional.event commit-msg
CONVENTIONAL_HOOK_CMD=$(
  cat <<'EOF'
f() { head -n1 "$1" | grep -qE '^(feat|fix|chore|docs)(\(.+\))?!?: .+' || { echo "Subject must follow Conventional Commits (allowed: feat, fix, chore, docs)" >&2; exit 1; }; }; f
EOF
)
git config hook.conventional.command "$CONVENTIONAL_HOOK_CMD"
